# Supabase project credentials (Project Settings > API)
# Leave these EMPTY to run in free local DEMO mode (no account, no payment).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Main room slug
VITE_ROOM_SLUG=addbuz

# Name shown for the default room
VITE_ROOM_NAME=Family Room

# This phone number gets HOST controls (mute all). Demo default is pre-filled.
VITE_HOST_PHONE=+8801712345678

# Text, images, join/leave notices all auto-delete after this many hours
VITE_RETENTION_HOURS=5

# Activity record (who sent what / joined / called) auto-deletes after this many minutes
VITE_ACTIVITY_TTL_MINUTES=30
